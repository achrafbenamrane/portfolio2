# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vendored MediaPipe WASM (~22 MB). Not committed because `postinstall` copies
# it out of node_modules — that is both smaller and safer, since the binaries
# must match the installed @mediapipe/tasks-vision version exactly and copying
# from the package guarantees they do. It needs no network at build time.
#
# public/models/hand_landmarker.task IS committed on purpose: it is fetched
# from a CDN rather than a package, and a build that depends on someone else's
# URL staying up is a build that eventually fails.
/public/mediapipe/wasm/

.vercel
.env*

# Scratch dir for the voice splitter
/.voice-work/
__pycache__/

# The raw voice take. The 18 cut clips ship; the clean continuous recording
# does not need to — it is a better voice-cloning sample than the clips are.
/assets-source/voice-take.*
/assets-source/voice-raw/
/assets-source/voice-preview/

# The store's build intermediates. Scripts in scripts/blender rebuild all of them;
# the bakes alone are 100 MB. What ships is in public/store.
/assets-source/store/build/
/assets-source/store/jersey/shots/
/assets-source/store/jersey/*.blend
/assets-source/store/jersey/*.blend1
/assets-source/store/jersey/*preview*.png
/assets-source/store/jersey/contact.png
/assets-source/store/jersey/atlas_check.png

# The museum's build intermediates, rebuilt by scripts/blender and scripts/museum_frames.py.
/assets-source/museum/
/assets-source/pizza/

# The 2090 game: bought in from Poly Haven and Solar System Scope, fetched again by the build notes.
/assets-source/tether/dl/
/assets-source/tether/build/

# The rejected first idea for /3d/2090, kept on this machine only.
/assets-source/y2090/

# The motorcycles' downloads and build intermediates, rebuilt by scripts/blender.
/assets-source/moto/
